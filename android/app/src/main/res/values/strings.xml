    <string name="home_greeting">Namaste</string>
    <string name="home_intro">Explore what the app will offer. Features below are previews and are not yet working.</string>
    <string name="home_module_membership">Membership</string>
    <string name="home_module_membership_desc">Apply to your residence chapter; the chapter secretary reviews and approves.</string>
    <string name="home_module_family">Family tree</string>
    <string name="home_module_family_desc">Record parents, grandparents on both sides, spouse, children and siblings.</string>
