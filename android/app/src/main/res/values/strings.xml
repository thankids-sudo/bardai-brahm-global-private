    <!-- Survey -->
    <string name="survey_title">Community Survey</string>
    <string name="survey_intro">The survey has two parts so household income is never counted twice. Every sensitive question will offer \"Prefer not to disclose\".</string>
    <string name="survey_individual">Individual questions</string>
    <string name="survey_individual_desc">Year of birth, education, skills, work, ancestral village, present residence, volunteering interests.</string>
    <string name="survey_household">Household questions</string>
    <string name="survey_household_desc">Household size, earning members, optional income band, housing, support needs.</string>
    <string name="survey_never_asked">Never asked: Aadhaar, bank details, exact income or DNA.</string>
    <string name="survey_start_disabled">Survey opens after secure sign-in is ready</string>

